---
// Karta artykułu — używana na stronie głównej i na liście /blog
import type { CollectionEntry } from "astro:content";
import ArticleCover from "./ArticleCover.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;
const fmt = new Intl.DateTimeFormat("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---

<a href={`/blog/${post.id}/`} class="post-card" data-category={data.category}>
  <ArticleCover category={data.category} cover={data.cover} alt={data.coverAlt} position={data.coverPosition} size="card" />
  <div class="body">
    <span class="tag">{data.category}</span>
    <h3>{data.title}</h3>
    <p class="excerpt">{data.description}</p>
    <div class="meta">
      <time datetime={data.date.toISOString()}>{fmt.format(data.date)}</time>
      <span class="read-more">Czytaj →</span>
    </div>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .post-card:hover {
    box-shadow: 0 10px 28px rgba(20, 28, 45, 0.1);
    transform: translateY(-2px);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 24px;
  }

  .tag {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 6px;
    background: oklch(0.96 0.005 256);
    font-size: 12px;
    font-weight: 600;
    color: oklch(0.45 0.02 256);
  }

  h3 {
    margin-top: 14px;
    font-size: 19px;
    line-height: 1.28;
    font-weight: 600;
    color: oklch(0.24 0.02 256);
  }

  .excerpt {
    margin-top: 10px;
    flex: 1;
    font-size: 14.5px;
    line-height: 1.55;
    color: oklch(0.5 0.018 256);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    font-size: 13px;
    color: oklch(0.55 0.018 256);
  }

  .read-more { font-weight: 600; color: oklch(0.5 0.1 32); }

  @media (max-width: 820px) {
    .body { padding: 18px 20px 20px; }
    h3 { font-size: 17px; }
  }
</style>