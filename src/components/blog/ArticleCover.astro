---
// Okładka artykułu: zdjęcie, jeśli artykuł je ma, albo grafika w stylu marki (granat, fale, logo).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  category: string;
  cover?: ImageMetadata;
  alt?: string;
  size?: "large" | "card";
  eager?: boolean;
}

const { category, cover, alt = "", size = "large", eager = false } = Astro.props;
const isLong = category.length > 12; // długie nazwy kategorii dostają mniejszy napis
---

<div class={`cover cover--${size}`}>
  {cover ? (
    <Image
      src={cover}
      alt={alt}
      widths={size === "large" ? [600, 900, 1400, 1800] : [400, 700]}
      sizes={size === "large" ? "(max-width: 960px) 100vw, 900px" : "(max-width: 820px) 100vw, 360px"}
      loading={eager ? "eager" : "lazy"}
    />
  ) : (
    <div class="fallback" role="img" aria-label={alt || `Grafika artykułu: ${category}`}>
      <svg class="waves" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,170 C200,126 400,126 600,170 C800,214 1000,214 1200,170 L1200,300 L0,300 Z" fill="rgba(61,73,92,0.55)" />
        <path d="M0,205 C220,235 380,155 600,195 C820,235 980,155 1200,205 L1200,300 L0,300 Z" fill="rgba(158,61,52,0.38)" />
        <path d="M0,250 C180,222 420,222 600,250 C780,278 1020,278 1200,250 L1200,300 L0,300 Z" fill="rgba(31,39,55,0.95)" />
      </svg>
      <img class="mark" src="/logo.svg" alt="" width="140" height="46" />
      <span class={`label${isLong ? " label--long" : ""}`}>{category}</span>
    </div>
  )}
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    background: oklch(0.22 0.02 256);
  }

  .cover--large { aspect-ratio: 21 / 9; border-radius: 14px; }
  .cover--card { aspect-ratio: 16 / 9; }

  .cover :global(img:not(.mark)) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fallback {
    position: absolute;
    inset: 0;
    background-color: oklch(0.22 0.02 256);
    background-image:
      linear-gradient(oklch(1 0 0 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, oklch(1 0 0 / 0.04) 1px, transparent 1px),
      radial-gradient(circle at 85% 15%, oklch(0.46 0.1 32 / 0.35), transparent 45%);
    background-size: 40px 40px, 40px 40px, 100% 100%;
  }

  .waves {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 62%;
  }

  .mark {
    position: absolute;
    top: 8%;
    left: 5%;
    height: 13%;
    width: auto;
    opacity: 0.95;
  }

  .label {
    position: absolute;
    left: 5%;
    bottom: 34%;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1;
  }

  .cover--large .label { font-size: clamp(36px, 7vw, 72px); }
  .cover--card .label { font-size: 30px; bottom: 36%; }

  .label { max-width: 80%; }
  .cover--large .label--long { font-size: clamp(28px, 4.6vw, 50px); line-height: 1.05; }
  .cover--card .label--long { font-size: 21px; line-height: 1.1; bottom: 38%; }
  .cover--card .mark { height: 15%; }
</style>
