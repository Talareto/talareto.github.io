---
const categories = [
  {
    label: "Księgowość i rachunkowość",
    services: [
      {
        num: "01",
        title: "Księgowość JDG",
        desc: "Pełna obsługa jednoosobowych działalności — KPiR, zasady ogólne, podatek liniowy. Każda forma opodatkowania dopasowana do Twojej sytuacji.",
      },
      {
        num: "02",
        title: "Rachunkowość sp. z o.o. i S.A.",
        desc: "Pełne księgi handlowe dla spółek kapitałowych. Specjalizujemy się w obsłudze sp. z o.o., w tym w rozliczeniach CIT-Estońskiego.",
      },
      {
        num: "03",
        title: "Wgląd do ksiąg w czasie rzeczywistym",
        desc: "Dostęp do programu księgowego i zapisów online — widzisz sytuację finansową firmy na bieżąco, bez czekania na raporty.",
      },
      {
        num: "04",
        title: "Obsługa NGO — fundacje i stowarzyszenia",
        desc: "Kompleksowa obsługa bilansowa i podatkowa organizacji pozarządowych — fundacji i stowarzyszeń (innych niż fundacje rodzinne).",
      },
      {
        num: "05",
        title: "Fundacje rodzinne — full serwis",
        desc: "Pełna obsługa księgowa, podatkowa i administracyjna fundacji rodzinnych. Od rejestracji po bieżące rozliczenia.",
      },
    ],
  },
  {
    label: "Doradztwo podatkowe i optymalizacje",
    services: [
      {
        num: "06",
        title: "Optymalizacje podatkowe",
        desc: "Legalne struktury minimalizujące obciążenia podatkowe. Wybór formy opodatkowania, planowanie wypłat, holding — analizujemy każdy wariant.",
      },
      {
        num: "07",
        title: "Kadry i płace",
        desc: "Umowy, listy płac, rozliczenia ZUS i pełna dokumentacja pracownicza zgodnie z obowiązującymi przepisami.",
      },
      {
        num: "08",
        title: "Zakładanie i restrukturyzacja firm",
        desc: "Rejestracja działalności, przekształcenia spółek, restrukturyzacje — dobieramy formę prawną i podatkową optymalną dla Twojego biznesu.",
      },
      {
        num: "09",
        title: "Upadłości konsumenckie",
        desc: "Dyskretna pomoc w przeprowadzeniu postępowania upadłościowego dla osób fizycznych — analiza sytuacji, przygotowanie wniosku, wsparcie na każdym etapie.",
        subtle: true,
      },
    ],
  },
  {
    label: "Controlling i analizy",
    services: [
      {
        num: "10",
        title: "Cost controlling i budżetowanie",
        desc: "Budżety, analizy odchyleń i kontrola kosztów w czasie rzeczywistym. Wiesz gdzie idą pieniądze zanim zrobi się problem.",
      },
      {
        num: "11",
        title: "Analizy ekonomiczne działalności",
        desc: "Rentowność, marże, struktura kosztów i przychodów — regularny przegląd kondycji finansowej Twojej firmy.",
      },
      {
        num: "12",
        title: "Analiza ryzyka upadłościowego",
        desc: "Wczesne wykrywanie sygnałów zagrożenia płynności. Działamy zanim pojawi się konieczność restrukturyzacji lub upadłości.",
      },
      {
        num: "13",
        title: "Planowanie płatności i ochrona płynności",
        desc: "Monitorowanie terminów spływu należności i spłaty zobowiązań. Wskazujemy optymalny moment na zewnętrzne finansowanie — zanim zabraknie gotówki.",
      },
      {
        num: "14",
        title: "Nadzór i wykonywanie płatności",
        desc: "Realizacja płatności z rachunku klienta lub w jego imieniu z rachunku spółki CanLead. Pełna kontrola, zero opóźnień.",
      },
    ],
  },
];
---

<section id="uslugi">
  <div class="container">
    <div class="intro">
      <div class="eyebrow">Usługi</div>
      <h2>Kompleksowa obsługa księgowa w jednym miejscu.</h2>
      <p>
        Od bieżącej księgowości po doradztwo biznesowe, prawne w tym
        restrukturyzacyjne — zajmiemy się formalnościami, abyś mógł skupić
        się na rozwoju firmy.
      </p>
    </div>

    {categories.map((cat) => (
      <div class="category">
        <div class="category-label">{cat.label}</div>
        <div class="grid">
          {cat.services.map((s) => (
            <div class={`card ${s.subtle ? "card-subtle" : ""}`}>
              <div class="card-num">{s.num}</div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  section { padding: 104px 64px 96px; }
  .container { max-width: 1180px; margin: 0 auto; }
  .intro { max-width: 680px; margin-bottom: 64px; }

  .eyebrow {
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: oklch(0.5 0.1 32);
  }

  h2 {
    font-size: 44px; font-weight: 600;
    color: oklch(0.22 0.02 256); line-height: 1.08;
    margin-top: 14px; text-wrap: balance;
  }

  .intro p {
    font-size: 17px; line-height: 1.6;
    color: oklch(0.5 0.018 256); margin-top: 18px;
  }

  .category { margin-bottom: 52px; }
  .category:last-child { margin-bottom: 0; }

  .category-label {
    font-family: "Space Grotesk", sans-serif;
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: oklch(0.55 0.018 256);
    padding-bottom: 16px;
    border-bottom: 1px solid oklch(0.91 0.006 256);
    margin-bottom: 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .card {
    background: #fff;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 8px; padding: 28px;
    transition: box-shadow 0.2s;
  }

  .card:hover { box-shadow: 0 8px 24px rgba(20,28,45,.08); }

  .card-subtle {
    border-style: dashed;
    opacity: 0.75;
  }

  .card-subtle:hover { opacity: 1; }

  .card-num {
    font-family: "Space Grotesk", sans-serif;
    font-size: 13px; font-weight: 600;
    color: oklch(0.52 0.1 32);
  }

  .card h3 {
    font-size: 19px; font-weight: 600;
    color: oklch(0.24 0.02 256); margin-top: 16px;
    line-height: 1.2;
  }

  .card p {
    font-size: 14.5px; line-height: 1.6;
    color: oklch(0.5 0.018 256); margin-top: 10px;
  }

  @media (max-width: 820px) {
    section { padding: 64px 20px 56px; }
    h2 { font-size: 30px; }
    .intro p { font-size: 15px; }
    .intro { margin-bottom: 40px; }
    .grid { grid-template-columns: 1fr; gap: 12px; }
    .card { padding: 20px; }
    .card h3 { font-size: 17px; }
  }
</style>
