---
const categories = [
  {
    label: "Księgowość i rachunkowość",
    services: [
      { title: "Księgowość JDG", desc: "Pełna obsługa jednoosobowych działalności — KPiR, zasady ogólne, podatek liniowy. Każda forma opodatkowania dopasowana do Twojej sytuacji." },
      { title: "Rachunkowość sp. z o.o. i S.A.", desc: "Pełne księgi handlowe dla spółek kapitałowych. Specjalizujemy się w obsłudze sp. z o.o., w tym w rozliczeniach CIT-Estońskiego." },
      { title: "Wgląd do ksiąg w czasie rzeczywistym", desc: "Dostęp do programu księgowego i zapisów online — widzisz sytuację finansową firmy na bieżąco, bez czekania na raporty." },
      { title: "Obsługa NGO — fundacje i stowarzyszenia", desc: "Kompleksowa obsługa bilansowa i podatkowa organizacji pozarządowych — fundacji i stowarzyszeń (innych niż fundacje rodzinne)." },
      { title: "Fundacje rodzinne — full serwis", desc: "Pełna obsługa księgowa, podatkowa i administracyjna fundacji rodzinnych. Od rejestracji po bieżące rozliczenia." },
    ],
  },
  {
    label: "Doradztwo podatkowe i optymalizacje",
    services: [
      { title: "Optymalizacje podatkowe", desc: "Legalne struktury minimalizujące obciążenia podatkowe. Wybór formy opodatkowania, planowanie wypłat, holding — analizujemy każdy wariant." },
      { title: "Kadry i płace", desc: "Umowy, listy płac, rozliczenia ZUS i pełna dokumentacja pracownicza zgodnie z obowiązującymi przepisami." },
      { title: "Zakładanie i restrukturyzacja firm", desc: "Rejestracja działalności, przekształcenia spółek, restrukturyzacje — dobieramy formę prawną i podatkową optymalną dla Twojego biznesu." },
      { title: "Upadłości konsumenckie", desc: "Dyskretna pomoc w przeprowadzeniu postępowania upadłościowego dla osób fizycznych — analiza sytuacji, przygotowanie wniosku, wsparcie na każdym etapie.", subtle: true },
    ],
  },
  {
    label: "Controlling i analizy",
    services: [
      { title: "Cost controlling i budżetowanie", desc: "Budżety, analizy odchyleń i kontrola kosztów w czasie rzeczywistym. Wiesz gdzie idą pieniądze zanim zrobi się problem." },
      { title: "Analizy ekonomiczne działalności", desc: "Rentowność, marże, struktura kosztów i przychodów — regularny przegląd kondycji finansowej Twojej firmy." },
      { title: "Analiza ryzyka upadłościowego", desc: "Wczesne wykrywanie sygnałów zagrożenia płynności. Działamy zanim pojawi się konieczność restrukturyzacji lub upadłości." },
      { title: "Planowanie płatności i ochrona płynności", desc: "Monitorowanie terminów spływu należności i spłaty zobowiązań. Wskazujemy optymalny moment na zewnętrzne finansowanie — zanim zabraknie gotówki." },
      { title: "Nadzór i wykonywanie płatności", desc: "Realizacja płatności z rachunku klienta lub w jego imieniu z rachunku spółki CanLead. Pełna kontrola, zero opóźnień." },
    ],
  },
];
---

<section id="uslugi">
  <div class="container">
    <div class="intro">
      <div class="eyebrow">Usługi</div>
      <h2>Kompleksowa obsługa księgowa w jednym miejscu.</h2>
      <p>
        Od bieżącej księgowości po doradztwo biznesowe, prawne w tym
        restrukturyzacyjne — zajmiemy się formalnościami, abyś mógł skupić
        się na rozwoju firmy.
      </p>
    </div>

    <div class="accordion">
      {categories.map((cat, i) => (
        <div class={`acc-item ${i === 0 ? "open" : ""}`} data-acc>
          <button class="acc-header" aria-expanded={i === 0 ? "true" : "false"}>
            <span class="acc-label">{cat.label}</span>
            <span class="acc-count">{cat.services.length} usług</span>
            <svg class="acc-arrow" viewBox="0 0 20 20" fill="none">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="acc-body">
            <ul class="service-list">
              {cat.services.map((s) => (
                <li class={`service-item ${s.subtle ? "subtle" : ""}`}>
                  <div class="service-content">
                    <div class="service-title">{s.title}</div>
                    <div class="service-desc">{s.desc}</div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-acc]").forEach((item) => {
    const btn = item.querySelector(".acc-header");
    btn?.addEventListener("click", () => {
      const isOpen = item.classList.contains("open");
      // Zamknij wszystkie
      document.querySelectorAll("[data-acc]").forEach((el) => {
        el.classList.remove("open");
        el.querySelector(".acc-header")?.setAttribute("aria-expanded", "false");
      });
      // Otwórz kliknięty (jeśli był zamknięty)
      if (!isOpen) {
        item.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>

<style>
  section { padding: 104px 64px 96px; }

  .container { max-width: 900px; margin: 0 auto; }

  .intro { max-width: 680px; margin-bottom: 56px; }

  .eyebrow {
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: oklch(0.5 0.1 32);
  }

  h2 {
    font-size: 44px; font-weight: 600;
    color: oklch(0.22 0.02 256); line-height: 1.08;
    margin-top: 14px; text-wrap: balance;
  }

  .intro p {
    font-size: 17px; line-height: 1.6;
    color: oklch(0.5 0.018 256); margin-top: 18px;
  }

  /* Accordion */
  .accordion {
    display: flex;
    flex-direction: column;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }

  .acc-item {
    border-bottom: 1px solid oklch(0.91 0.006 256);
  }

  .acc-item:last-child { border-bottom: none; }

  .acc-header {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px 28px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s;
  }

  .acc-header:hover { background: oklch(0.985 0.004 256); }

  .acc-item.open .acc-header { background: oklch(0.985 0.004 256); }

  .acc-label {
    font-family: "Space Grotesk", sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: oklch(0.24 0.02 256);
    flex: 1;
  }

  .acc-count {
    font-size: 13px;
    color: oklch(0.58 0.018 256);
    white-space: nowrap;
  }

  .acc-arrow {
    width: 20px; height: 20px;
    color: oklch(0.55 0.018 256);
    transition: transform 0.25s;
    flex-shrink: 0;
  }

  .acc-item.open .acc-arrow { transform: rotate(180deg); }

  /* Body — animate with grid trick */
  .acc-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .acc-item.open .acc-body {
    grid-template-rows: 1fr;
  }

  .acc-body > ul {
    overflow: hidden;
  }

  /* Service list */
  .service-list {
    list-style: none;
    padding: 0 28px 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .service-item {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid oklch(0.94 0.005 256);
    align-items: flex-start;
  }

  .service-item:last-child { border-bottom: none; }

  .service-item.subtle { opacity: 0.6; }
  .service-item.subtle:hover { opacity: 1; transition: opacity 0.2s; }

  .service-title {
    font-size: 15px;
    font-weight: 600;
    color: oklch(0.26 0.02 256);
  }

  .service-desc {
    font-size: 14px;
    line-height: 1.6;
    color: oklch(0.52 0.018 256);
    margin-top: 4px;
  }

  @media (max-width: 820px) {
    section { padding: 64px 20px 56px; }
    h2 { font-size: 30px; }
    .intro p { font-size: 15px; }
    .intro { margin-bottom: 36px; }
    .acc-header { padding: 18px 20px; }
    .acc-label { font-size: 15px; }
    .service-list { padding: 0 20px 16px; }
  }
</style>