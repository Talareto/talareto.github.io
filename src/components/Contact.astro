---
---

<section id="kontakt">
  <div class="container">
    <div class="info-col">
      <div class="eyebrow">Kontakt</div>
      <h2>Porozmawiajmy o Twojej księgowości</h2>
      <p>Zostaw wiadomość — odpowiadamy w ciągu jednego dnia roboczego i proponujemy bezpłatną konsultację bez zobowiązań.</p>
      <div class="contact-details">
        <div class="detail"><span class="detail-label">Telefon</span><span class="detail-value">+48 734 184 042</span></div>
        <div class="detail"><span class="detail-label">E-mail</span><span class="detail-value">biuro@canlead.pl</span></div>
        <div class="detail"><span class="detail-label">Adres</span><span class="detail-value">ul. Grunwaldzka 12B/8, 99-300 Kutno</span></div>
        <div class="detail"><span class="detail-label">Godziny pracy</span><span class="detail-value">Pn–Pt, 8:00–17:00</span></div>
      </div>
    </div>
    <div class="form-card">
      <form id="contact-form" novalidate>
        <div class="form-row">
          <div class="field">
            <label for="name">Imię i nazwisko <span class="req">*</span></label>
            <input id="name" name="imie_nazwisko" type="text" placeholder = "Imię i nazwisko" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="phone">Telefon</label>
            <input id="phone" name="telefon" type="tel" placeholder= "Telefon" autocomplete="tel" />
          </div>
        </div>
        <div class="field">
          <label for="email">E-mail <span class="req">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="Email" required />
        </div>
        <div class="field">
          <label for="message">Wiadomość <span class="req">*</span></label>
          <textarea id="message" name="wiadomosc" rows="4" placeholder="W czym możemy pomóc?" required></textarea>
        </div>
        <!-- Pułapka na boty: pole niewidoczne dla ludzi -->
        <div class="hp" aria-hidden="true">
          <label for="c-website">Strona www</label>
          <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="submit-btn" id="contact-submit">Wyślij wiadomość</button>
        <p class="form-status" id="contact-status" role="status" hidden></p>
        <p class="disclaimer">Wysyłając formularz, akceptujesz przetwarzanie danych w celu kontaktu zgodnie z <a href="/polityka-prywatnosci">polityką prywatności</a>.</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { sendForm, OFFICE_EMAIL } from "../scripts/send-form";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submit = document.getElementById("contact-submit") as HTMLButtonElement;
  const status = document.getElementById("contact-status") as HTMLParagraphElement;
  const loadedAt = Date.now();

  function setError(el: HTMLElement, msg: string) {
    const field = el.closest(".field") as HTMLElement;
    field.classList.add("has-error");
    let m = field.querySelector(".error-msg") as HTMLElement | null;
    if (!m) { m = document.createElement("span"); m.className = "error-msg"; field.appendChild(m); }
    m.textContent = msg;
  }
  form.addEventListener("input", (e) => {
    const field = (e.target as HTMLElement).closest(".field");
    field?.classList.remove("has-error");
    field?.querySelector(".error-msg")?.remove();
  });

  function showStatus(kind: "ok" | "error", text: string) {
    status.textContent = text;
    status.className = `form-status form-status--${kind}`;
    status.hidden = false;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    status.hidden = true;
    const fd = new FormData(form);
    const get = (k: string) => String(fd.get(k) ?? "").trim();
    const data: Record<string, string> = {
      imie_nazwisko: get("imie_nazwisko"),
      email: get("email"),
      telefon: get("telefon"),
      wiadomosc: get("wiadomosc"),
    };

    let first: HTMLElement | null = null;
    const fail = (id: string, msg: string) => { const el = document.getElementById(id)!; setError(el, msg); first ??= el; };
    if (!data.imie_nazwisko) fail("name", "Podaj imię i nazwisko.");
    if (!data.email) fail("email", "Podaj adres e-mail.");
    else if (!(document.getElementById("email") as HTMLInputElement).validity.valid) fail("email", "Wpisz poprawny adres e-mail.");
    if (!data.wiadomosc) fail("message", "Napisz, w czym możemy pomóc.");
    if (first) { (first as HTMLElement).focus(); return; }

    submit.disabled = true;
    submit.textContent = "Wysyłanie…";
    const body = [`Imię i nazwisko: ${data.imie_nazwisko}`, `E-mail: ${data.email}`, data.telefon && `Telefon: ${data.telefon}`, "", data.wiadomosc]
      .filter((l) => l !== "" && l !== undefined).join("\n");
    const result = await sendForm("kontakt", data, { website: get("website"), startedAt: loadedAt },
      { subject: `Wiadomość ze strony — ${data.imie_nazwisko}`, body });
    submit.disabled = false;
    submit.textContent = "Wyślij wiadomość";

    if (result.status === "sent") {
      form.reset();
      showStatus("ok", "Dziękujemy! Wiadomość została wysłana — odezwiemy się w ciągu jednego dnia roboczego.");
    } else if (result.status === "mailto") {
      showStatus("ok", `Otworzyliśmy Twój program pocztowy z gotową wiadomością do ${OFFICE_EMAIL} — wystarczy ją wysłać.`);
    } else {
      showStatus("error", result.message);
    }
  });
</script>

<style>
  section {
    padding: 104px 64px 96px;
    border-top: 1px solid oklch(0.93 0.006 256);
  }

  .container {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px; max-width: 1140px; margin: 0 auto;
  }

  .eyebrow {
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: oklch(0.5 0.1 32);
  }

  h2 {
    font-size: 42px; font-weight: 600;
    color: oklch(0.22 0.02 256); line-height: 1.1;
    margin-top: 14px; text-wrap: balance;
  }

  .info-col > p {
    font-size: 16px; line-height: 1.6;
    color: oklch(0.5 0.018 256); margin-top: 18px; max-width: 400px;
  }

  .contact-details {
    margin-top: 36px;
    display: flex; flex-direction: column; gap: 18px;
  }

  .detail { display: flex; flex-direction: column; gap: 3px; }

  .detail-label { font-size: 13px; color: oklch(0.55 0.018 256); }

  .detail-value { font-size: 16px; font-weight: 600; color: oklch(0.26 0.02 256); }

  .form-card {
    background: #fff;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 8px; padding: 34px;
  }

  #contact-form { display: flex; flex-direction: column; gap: 18px; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr; gap: 16px;
  }

  .field { display: flex; flex-direction: column; gap: 7px; }

  label { font-size: 13px; font-weight: 600; color: oklch(0.42 0.02 256); }

  input, textarea {
    width: 100%; padding: 13px 15px;
    border-radius: 8px; border: 1px solid oklch(0.9 0.006 256);
    background: oklch(0.99 0.003 256);
    font-size: 15px; font-family: "Manrope", sans-serif;
    color: oklch(0.25 0.02 256); outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  input:focus, textarea:focus { border-color: oklch(0.46 0.1 32); }

  textarea { resize: vertical; }

  .req { color: oklch(0.5 0.1 32); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .has-error input, .has-error textarea { border-color: oklch(0.55 0.18 25); }
  .field :global(.error-msg) { font-size: 12.5px; font-weight: 500; color: oklch(0.5 0.18 25); }
  .submit-btn:disabled { opacity: 0.6; cursor: wait; }
  .form-status { margin-top: 14px; padding: 12px 14px; border-radius: 8px; font-size: 14px; line-height: 1.5; }
  .form-status--ok { background: oklch(0.95 0.04 150); color: oklch(0.38 0.1 150); }
  .form-status--error { background: oklch(0.96 0.03 25); color: oklch(0.42 0.14 25); }

  .submit-btn {
    padding: 15px; border-radius: 8px; border: none;
    background: oklch(0.46 0.1 32); color: #fff;
    font-weight: 600; font-size: 16px; cursor: pointer;
    font-family: "Manrope", sans-serif;
    transition: opacity 0.2s;
  }

  .submit-btn:hover { opacity: 0.88; }

  .disclaimer {
    font-size: 12.5px; color: oklch(0.58 0.018 256);
    text-align: center; line-height: 1.5;
  }

  @media (max-width: 820px) {
    section { padding: 64px 20px 56px; }

    .container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    h2 { font-size: 30px; }

    .info-col > p { font-size: 15px; }

    .contact-details { margin-top: 24px; gap: 14px; }

    .detail-value { font-size: 15px; }

    .form-card { padding: 22px; }

    .form-row { grid-template-columns: 1fr; }
  }
  .disclaimer a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .disclaimer a:hover { color: oklch(0.46 0.1 32); }
</style>