---
interface Plan {
  name: string; prefix: string; price: string; period: string;
  desc: string; features: string[]; highlighted: boolean;
}

interface Props { highlight?: string; }
const { highlight = "Biznes" } = Astro.props;

const plans: Plan[] = [
  {
    name: "Start", prefix: "od", price: "199 zł", period: "/mies netto",
    desc: "Dla jednoosobowych działalności i ryczałtu.",
    features: ["Do 20 dokumentów / mies.", "Rozliczenia ZUS i US", "Roczne zeznanie podatkowe", "Kontakt e-mail i telefoniczny"],
    highlighted: "Start" === highlight,
  },
  {
    name: "Biznes", prefix: "od", price: "449 zł", period: "/mies netto",
    desc: "Dla rozwijających się firm i spółek osobowych.",
    features: ["Do 80 dokumentów / mies.", "Pełna księgowość lub KPiR", "Kadry i płace do 5 osób", "Dedykowany opiekun", "Bieżące doradztwo podatkowe"],
    highlighted: "Biznes" === highlight,
  },
  {
    name: "Premium", prefix: "", price: "Wycena", period: "indywidualna",
    desc: "Dla spółek z o.o. i większych organizacji.",
    features: ["Nielimitowane dokumenty", "Pełne księgi handlowe", "Kadry i płace bez limitu", "Doradztwo biznesowe i analizy", "Priorytetowe wsparcie"],
    highlighted: "Premium" === highlight,
  },
];
---

<section id="cennik">
  <div class="container">
    <div class="intro">
      <div class="eyebrow">Cennik</div>
      <h2>Przejrzyste pakiety bez ukrytych opłat.</h2>
      <p>Wybierz pakiet dopasowany do rozmiaru firmy. Każdy obejmuje pełną obsługę i dedykowanego opiekuna.</p>
    </div>
    <div class="plans-grid">
      {plans.map((plan) => (
        <div class={`plan-card ${plan.highlighted ? "highlighted" : ""}`}>
          {plan.highlighted && <div class="badge">Najpopularniejszy</div>}
          <div class="plan-name" style={plan.highlighted ? "color:oklch(0.78 0.015 256)" : "color:oklch(0.45 0.02 256)"}>{plan.name}</div>
          <div class="plan-price-row">
            {plan.prefix && <span class="plan-prefix">{plan.prefix}</span>}
            <span class="plan-price" style={plan.highlighted ? "color:#fff" : "color:oklch(0.22 0.02 256)"}>{plan.price}</span>
            <span class="plan-period" style={plan.highlighted ? "color:oklch(0.7 0.015 256)" : "color:oklch(0.5 0.018 256)"}>{plan.period}</span>
          </div>
          <p class="plan-desc" style={plan.highlighted ? "color:oklch(0.72 0.015 256)" : "color:oklch(0.5 0.018 256)"}>{plan.desc}</p>
          <hr style={`border-color:${plan.highlighted ? "oklch(0.32 0.02 256)" : "oklch(0.93 0.006 256)"}`} />
          <ul>
            {plan.features.map((f) => (
              <li style={plan.highlighted ? "color:oklch(0.85 0.012 256)" : "color:oklch(0.35 0.02 256)"}>
                <span class="dot" style={plan.highlighted ? "color:oklch(0.72 0.09 32)" : "color:oklch(0.55 0.1 32)"}>✓</span>{f}
              </li>
            ))}
          </ul>
          <a href="#kontakt" class={`plan-btn ${plan.highlighted ? "plan-btn-hot" : "plan-btn-default"}`}>Wybierz pakiet</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section { padding: 96px 64px; border-top: 1px solid oklch(0.93 0.006 256); }
  .container { max-width: 1180px; margin: 0 auto; }
  .intro { text-align: center; max-width: 560px; margin: 0 auto 52px; }
  .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: oklch(0.5 0.1 32); }
  h2 { font-size: 44px; font-weight: 600; color: oklch(0.22 0.02 256); line-height: 1.08; margin-top: 14px; text-wrap: balance; }
  .intro p { font-size: 17px; line-height: 1.6; color: oklch(0.5 0.018 256); margin-top: 14px; }

  .plans-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; align-items: start; }

  .plan-card {
    position: relative; background: #fff;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 8px; padding: 34px 30px;
    display: flex; flex-direction: column;
    transition: background 0.25s, border-color 0.25s, box-shadow 0.25s;
  }

  .plan-card.highlighted { background: oklch(0.22 0.02 256); border-color: oklch(0.22 0.02 256); box-shadow: 0 16px 40px rgba(20,28,45,.2); }

  .plan-card:not(.highlighted):hover { background: oklch(0.22 0.02 256); border-color: oklch(0.22 0.02 256); box-shadow: 0 16px 40px rgba(20,28,45,.2); }
  .plan-card:not(.highlighted):hover .plan-name { color: oklch(0.78 0.015 256) !important; }
  .plan-card:not(.highlighted):hover .plan-price { color: #fff !important; }
  .plan-card:not(.highlighted):hover .plan-period,
  .plan-card:not(.highlighted):hover .plan-desc,
  .plan-card:not(.highlighted):hover li { color: oklch(0.72 0.015 256) !important; }
  .plan-card:not(.highlighted):hover hr { border-color: oklch(0.32 0.02 256) !important; }
  .plan-card:not(.highlighted):hover .plan-btn-default { background: oklch(0.46 0.1 32); border-color: oklch(0.46 0.1 32); color: #fff; }

  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted { background: #fff; border-color: oklch(0.91 0.006 256); box-shadow: none; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-name { color: oklch(0.45 0.02 256) !important; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-price { color: oklch(0.22 0.02 256) !important; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-period,
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-desc,
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted li { color: oklch(0.5 0.018 256) !important; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted hr { border-color: oklch(0.93 0.006 256) !important; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-btn-hot { background: transparent; border: 1px solid oklch(0.85 0.008 256); color: oklch(0.25 0.02 256); }

  .badge { align-self: flex-start; padding: 5px 12px; border-radius: 8px; background: oklch(0.46 0.1 32); color: #fff; font-size: 12px; font-weight: 600; margin-bottom: 18px; }
  .plan-name { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .plan-price-row { display: flex; align-items: baseline; gap: 6px; margin-top: 12px; }
  .plan-prefix { font-size: 14px; color: oklch(0.5 0.018 256); }
  .plan-price { font-family: "Space Grotesk", sans-serif; font-size: 38px; font-weight: 700; line-height: 1; }
  .plan-period { font-size: 14px; }
  .plan-desc { font-size: 14.5px; line-height: 1.5; margin-top: 10px; }
  hr { border: none; border-top: 1px solid; margin: 20px 0; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  li { font-size: 14.5px; display: flex; gap: 8px; align-items: flex-start; }
  .dot { font-size: 13px; flex-shrink: 0; margin-top: 1px; }
  .plan-btn { display: block; text-align: center; margin-top: 24px; padding: 14px; border-radius: 8px; font-weight: 600; font-size: 15px; transition: background 0.25s, border-color 0.25s, color 0.25s, opacity 0.2s; }
  .plan-btn:hover { opacity: 0.85; }
  .plan-btn-hot { background: oklch(0.46 0.1 32); color: #fff; border: none; }
  .plan-btn-default { border: 1px solid oklch(0.85 0.008 256); color: oklch(0.25 0.02 256); }

  @media (max-width: 820px) {
  section { padding: 64px 20px; }
  h2 { font-size: 30px; }
  .intro p { font-size: 15px; }
  .intro { margin-bottom: 32px; }
  .plans-grid { grid-template-columns: 1fr; gap: 14px; }
  .plan-card { padding: 24px 20px; }
  .plan-price { font-size: 30px; }

  /* Wyłącz hover-swap na mobile */
  .plan-card:not(.highlighted):hover {
    background: #fff !important;
    border-color: oklch(0.91 0.006 256) !important;
    box-shadow: none !important;
  }
  .plan-card:not(.highlighted):hover .plan-name { color: oklch(0.45 0.02 256) !important; }
  .plan-card:not(.highlighted):hover .plan-price { color: oklch(0.22 0.02 256) !important; }
  .plan-card:not(.highlighted):hover .plan-period,
  .plan-card:not(.highlighted):hover .plan-desc,
  .plan-card:not(.highlighted):hover li { color: oklch(0.5 0.018 256) !important; }
  .plan-card:not(.highlighted):hover hr { border-color: oklch(0.93 0.006 256) !important; }
  .plan-card:not(.highlighted):hover .plan-btn-default {
    background: transparent !important;
    border-color: oklch(0.85 0.008 256) !important;
    color: oklch(0.25 0.02 256) !important;
  }

  /* Biznes zostaje ciemny */
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted {
    background: oklch(0.22 0.02 256) !important;
    border-color: oklch(0.22 0.02 256) !important;
    box-shadow: 0 16px 40px rgba(20,28,45,.2) !important;
  }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-name { color: oklch(0.78 0.015 256) !important; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-price { color: #fff !important; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-period,
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-desc,
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted li { color: oklch(0.72 0.015 256) !important; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-btn-hot {
    background: oklch(0.46 0.1 32) !important;
    border: none !important;
    color: #fff !important;
  }
}
</style>