---
interface Plan {
  name: string;
  segment: string;
  limit: string;
  prefix: string;
  price: string;
  period: string;
  desc: string;
  features: string[];
  highlighted: boolean;
}

const jdgPlans: Plan[] = [
  {
    name: "Pakiet Start",
    segment: "Mała JDG",
    limit: "do 20 rekordów księgowych",
    prefix: "",
    price: "299 zł",
    period: "/mies. netto",
    desc: "Dla jednoosobowych działalności z niewielką liczbą dokumentów.",
    features: [
      "Do 20 rekordów księgowych / mies.",
      "Rozliczenia ZUS i US",
      "Roczne zeznanie podatkowe",
      "Kontakt e-mail i telefoniczny",
    ],
    highlighted: false,
  },
  {
    name: "Pakiet Optima",
    segment: "Mała JDG",
    limit: "do 50 rekordów księgowych",
    prefix: "od",
    price: "300 zł",
    period: "/mies. netto",
    desc: "Dla rozwijających się jednoosobowych działalności.",
    features: [
      "Do 50 rekordów księgowych / mies.",
      "Rozliczenia ZUS i US",
      "Roczne zeznanie podatkowe",
      "Bieżące doradztwo podatkowe",
      "Dedykowany opiekun",
    ],
    highlighted: true,
  },
  {
    name: "Pakiet PRO",
    segment: "Mała JDG",
    limit: "do 100 rekordów księgowych",
    prefix: "od",
    price: "500 zł",
    period: "/mies. netto",
    desc: "Dla aktywnych działalności z dużą liczbą dokumentów.",
    features: [
      "Do 100 rekordów księgowych / mies.",
      "Rozliczenia ZUS i US",
      "Roczne zeznanie podatkowe",
      "Bieżące doradztwo podatkowe",
      "Dedykowany opiekun",
    ],
    highlighted: false,
  },
];

const spolkaPlans: Plan[] = [
  {
    name: "Mała Sp. z o.o.",
    segment: "Ryczałt",
    limit: "do 45 rekordów księgowych",
    prefix: "",
    price: "450 zł",
    period: "/mies. netto",
    desc: "Mały podatnik na pełnej księgowości i VAT.",
    features: [
      "Do 45 rekordów księgowych / mies.",
      "Pełna księgowość",
      "Rozliczenia VAT",
      "Dedykowany opiekun",
    ],
    highlighted: false,
  },
  {
    name: "Średnia Sp. z o.o.",
    segment: "Większy mały podatnik",
    limit: "do 100 rekordów księgowych",
    prefix: "od",
    price: "1100 zł",
    period: "/mies. netto",
    desc: "Większy mały podatnik na pełnej księgowości i VAT.",
    features: [
      "Do 100 rekordów księgowych / mies.",
      "Pełna księgowość",
      "Rozliczenia VAT",
      "Bieżące doradztwo podatkowe",
      "Dedykowany opiekun",
    ],
    highlighted: true,
  },
  {
    name: "Średnia Sp. z o.o.",
    segment: "Średni podatnik",
    limit: "do 300 rekordów księgowych",
    prefix: "od",
    price: "2700 zł",
    period: "/mies. netto",
    desc: "Średni podatnik na pełnej księgowości i VAT.",
    features: [
      "Do 300 rekordów księgowych / mies.",
      "Pełna księgowość",
      "Rozliczenia VAT",
      "Bieżące doradztwo podatkowe",
      "Dedykowany opiekun",
    ],
    highlighted: false,
  },
  {
    name: "Średnia Sp. z o.o.",
    segment: "Średni podatnik",
    limit: "do 500 rekordów księgowych",
    prefix: "od",
    price: "4300 zł",
    period: "/mies. netto",
    desc: "Średni podatnik na pełnej księgowości i VAT.",
    features: [
      "Do 500 rekordów księgowych / mies.",
      "Pełna księgowość",
      "Rozliczenia VAT",
      "Bieżące doradztwo podatkowe",
      "Dedykowany opiekun",
    ],
    highlighted: false,
  },
];

const customFeatures = [
  "Nielimitowane dokumenty",
  "Pełne księgi handlowe",
  "Kadry i płace bez limitu",
  "CIT Estoński, NGO, fundacje rodzinne",
  "Controlling i analizy ekonomiczne",
  "Priorytetowe wsparcie",
];

const groups = [
  { id: "jdg", label: "JDG", plans: jdgPlans, cols: 3 },
  { id: "spolki", label: "Sp. z o.o.", plans: spolkaPlans, cols: 4 },
];
---

<section id="cennik">
  <div class="container">
    <div class="intro">
      <div class="eyebrow">Cennik</div>
      <h2>Przejrzyste pakiety bez ukrytych opłat.</h2>
      <p>Wybierz pakiet dopasowany do formy i rozmiaru firmy. Każdy obejmuje pełną obsługę i dedykowanego opiekuna.</p>
    </div>

    <div class="tabs">
      <input type="radio" name="pricing-tab" id="tab-jdg" checked />
      <input type="radio" name="pricing-tab" id="tab-spolki" />
      <input type="radio" name="pricing-tab" id="tab-indywidualna" />

      <div class="tab-list" role="radiogroup" aria-label="Rodzaj działalności">
        <label for="tab-jdg">JDG</label>
        <label for="tab-spolki">Sp. z o.o.</label>
        <label for="tab-indywidualna">Wycena indywidualna</label>
      </div>

      {groups.map((group) => (
        <div class={`panel panel-${group.id}`}>
          <div class={`plans-grid cols-${group.cols}`}>
            {group.plans.map((plan) => (
              <div class={`plan-card ${plan.highlighted ? "highlighted" : ""}`}>
                {plan.highlighted && <div class="badge">Najpopularniejszy</div>}
                <div class="plan-name">{plan.name}</div>
                <div class="plan-segment">{plan.segment}</div>
                <div class="plan-price-row">
                  {plan.prefix && <span class="plan-prefix">{plan.prefix}</span>}
                  <span class="plan-price">{plan.price}</span>
                  <span class="plan-period">{plan.period}</span>
                </div>
                <div class="plan-limit">{plan.limit}</div>
                <p class="plan-desc">{plan.desc}</p>
                <hr />
                <ul>
                  {plan.features.map((f) => (
                    <li><span class="dot">✓</span>{f}</li>
                  ))}
                </ul>
                <a
                  href="#kontakt"
                  class={`plan-btn ${plan.highlighted ? "plan-btn-hot" : "plan-btn-default"}`}
                  data-plan-name={plan.name}
                  data-plan-details={`${plan.segment}, ${plan.limit}, ${plan.prefix ? plan.prefix + " " : ""}${plan.price} ${plan.period}`}
                  data-plan-label={`${plan.name} · ${plan.limit}`}
                >Wybierz pakiet</a>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="panel panel-indywidualna">
        <div class="custom-card">
          <div class="custom-head">
            <div class="plan-name">Premium</div>
            <div class="custom-price">Wycena indywidualna</div>
            <p class="plan-desc">
              Dla spółek z o.o. powyżej 500 rekordów księgowych, S.A. i większych organizacji,
              a także dla firm o nietypowym profilu. Przygotujemy ofertę dopasowaną do Twojej działalności.
            </p>
            <a href="#kontakt" class="plan-btn plan-btn-hot" data-plan-name="Wycena indywidualna" data-plan-custom data-plan-label="Wycena indywidualna">Poproś o wycenę</a>
          </div>
          <ul class="custom-features">
            {customFeatures.map((f) => (
              <li><span class="dot">✓</span>{f}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <p class="note">Wszystkie ceny są cenami netto. Ostateczna cena zależy od liczby rekordów księgowych i zakresu usług.</p>
  </div>
</section>

<style>
  section { padding: 96px 64px; border-top: 1px solid oklch(0.93 0.006 256); }
  .container { max-width: 1180px; margin: 0 auto; }
  .intro { text-align: center; max-width: 560px; margin: 0 auto 40px; }
  .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: oklch(0.5 0.1 32); }
  h2 { font-size: 44px; font-weight: 600; color: oklch(0.22 0.02 256); line-height: 1.08; margin-top: 14px; text-wrap: balance; }
  .intro p { font-size: 17px; line-height: 1.6; color: oklch(0.5 0.018 256); margin-top: 14px; }

  /* ---------- Zakładki ---------- */
  .tabs > input { position: absolute; opacity: 0; pointer-events: none; }
  .tab-list {
    display: flex; justify-content: center; gap: 4px;
    width: fit-content; margin: 0 auto 40px; padding: 4px;
    border: 1px solid oklch(0.91 0.006 256); border-radius: 10px; background: #fff;
  }
  .tab-list label {
    padding: 10px 20px; border-radius: 7px; cursor: pointer;
    font-size: 15px; font-weight: 600; color: oklch(0.45 0.02 256);
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .tab-list label:hover { color: oklch(0.22 0.02 256); }
  #tab-jdg:checked ~ .tab-list label[for="tab-jdg"],
  #tab-spolki:checked ~ .tab-list label[for="tab-spolki"],
  #tab-indywidualna:checked ~ .tab-list label[for="tab-indywidualna"] {
    background: oklch(0.22 0.02 256); color: #fff;
  }
  #tab-jdg:focus-visible ~ .tab-list label[for="tab-jdg"],
  #tab-spolki:focus-visible ~ .tab-list label[for="tab-spolki"],
  #tab-indywidualna:focus-visible ~ .tab-list label[for="tab-indywidualna"] {
    outline: 2px solid oklch(0.46 0.1 32); outline-offset: 2px;
  }

  .panel { display: none; }
  #tab-jdg:checked ~ .panel-jdg,
  #tab-spolki:checked ~ .panel-spolki,
  #tab-indywidualna:checked ~ .panel-indywidualna { display: block; animation: fade 0.3s ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  /* ---------- Karty ---------- */
  .plans-grid { display: grid; gap: 20px; align-items: stretch; }
  .plans-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .plans-grid.cols-4 { grid-template-columns: repeat(4, 1fr); gap: 16px; }

  .plan-card {
    position: relative; background: #fff;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 8px; padding: 34px 30px;
    display: flex; flex-direction: column;
    transition: background 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .cols-4 .plan-card { padding: 30px 22px; }

  /* Kolory domyślne (jasna karta) */
  .plan-name { color: oklch(0.45 0.02 256); }
  .plan-segment { color: oklch(0.55 0.1 32); }
  .plan-price { color: oklch(0.22 0.02 256); }
  .plan-prefix, .plan-period, .plan-desc { color: oklch(0.5 0.018 256); }
  .plan-limit { color: oklch(0.3 0.02 256); background: oklch(0.96 0.006 256); }
  li { color: oklch(0.35 0.02 256); }
  .dot { color: oklch(0.55 0.1 32); }
  hr { border-color: oklch(0.93 0.006 256); }

  /* Ciemna karta: wyróżniona lub najechana */
  .plan-card.highlighted,
  .plan-card:not(.highlighted):hover {
    background: oklch(0.22 0.02 256); border-color: oklch(0.22 0.02 256);
    box-shadow: 0 16px 40px rgba(20,28,45,.2);
  }
  .plan-card.highlighted .plan-name,
  .plan-card:not(.highlighted):hover .plan-name { color: oklch(0.78 0.015 256); }
  .plan-card.highlighted .plan-segment,
  .plan-card:not(.highlighted):hover .plan-segment { color: oklch(0.72 0.09 32); }
  .plan-card.highlighted .plan-price,
  .plan-card:not(.highlighted):hover .plan-price { color: #fff; }
  .plan-card.highlighted :is(.plan-prefix, .plan-period, .plan-desc),
  .plan-card:not(.highlighted):hover :is(.plan-prefix, .plan-period, .plan-desc) { color: oklch(0.72 0.015 256); }
  .plan-card.highlighted .plan-limit,
  .plan-card:not(.highlighted):hover .plan-limit { color: #fff; background: oklch(1 0 0 / 0.08); }
  .plan-card.highlighted li,
  .plan-card:not(.highlighted):hover li { color: oklch(0.85 0.012 256); }
  .plan-card.highlighted .dot,
  .plan-card:not(.highlighted):hover .dot { color: oklch(0.72 0.09 32); }
  .plan-card.highlighted hr,
  .plan-card:not(.highlighted):hover hr { border-color: oklch(1 0 0 / 0.15); }
  .plan-card:not(.highlighted):hover .plan-btn-default { background: oklch(0.46 0.1 32); border-color: oklch(0.46 0.1 32); color: #fff; }

  /* Gdy najechana inna karta, wyróżniona wraca do jasnej */
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted { background: #fff; border-color: oklch(0.91 0.006 256); box-shadow: none; }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-name { color: oklch(0.45 0.02 256); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-segment { color: oklch(0.55 0.1 32); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-price { color: oklch(0.22 0.02 256); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted :is(.plan-prefix, .plan-period, .plan-desc) { color: oklch(0.5 0.018 256); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-limit { color: oklch(0.3 0.02 256); background: oklch(0.96 0.006 256); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted li { color: oklch(0.35 0.02 256); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .dot { color: oklch(0.55 0.1 32); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted hr { border-color: oklch(0.93 0.006 256); }
  .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-btn-hot { background: transparent; border: 1px solid oklch(0.85 0.008 256); color: oklch(0.25 0.02 256); }

  .badge { align-self: flex-start; padding: 5px 12px; border-radius: 8px; background: oklch(0.46 0.1 32); color: #fff; font-size: 12px; font-weight: 600; margin-bottom: 18px; }
  .plan-name { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .plan-segment { font-size: 13px; font-weight: 500; margin-top: 4px; }
  .plan-price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 6px; margin-top: 14px; }
  .plan-prefix { font-size: 14px; }
  .plan-price { font-family: "Space Grotesk", sans-serif; font-size: 38px; font-weight: 700; line-height: 1; white-space: nowrap; }
  .cols-4 .plan-price { font-size: 34px; }
  .plan-period { font-size: 14px; }
  .plan-limit { align-self: flex-start; margin-top: 14px; padding: 5px 10px; border-radius: 6px; font-size: 13px; font-weight: 600; transition: background 0.25s, color 0.25s; }
  .plan-desc { font-size: 14.5px; line-height: 1.5; margin-top: 12px; }
  hr { border: none; border-top: 1px solid; margin: 20px 0; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  li { font-size: 14.5px; display: flex; gap: 8px; align-items: flex-start; }
  .dot { font-size: 13px; flex-shrink: 0; margin-top: 1px; }
  .plan-btn { display: block; text-align: center; margin-top: 24px; padding: 14px; border-radius: 8px; font-weight: 600; font-size: 15px; transition: background 0.25s, border-color 0.25s, color 0.25s, opacity 0.2s; }
  .plan-btn:hover { opacity: 0.85; }
  .plan-btn-hot { background: oklch(0.46 0.1 32); color: #fff; border: none; }
  .plan-btn-default { border: 1px solid oklch(0.85 0.008 256); color: oklch(0.25 0.02 256); background: transparent; }

  /* ---------- Wycena indywidualna ---------- */
  .custom-card {
    max-width: 920px; margin: 0 auto;
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center;
    background: oklch(0.22 0.02 256); border-radius: 8px; padding: 44px 44px;
    box-shadow: 0 16px 40px rgba(20,28,45,.2);
  }
  .custom-card .plan-name { color: oklch(0.78 0.015 256); }
  .custom-price { font-family: "Space Grotesk", sans-serif; font-size: 34px; font-weight: 700; line-height: 1.1; color: #fff; margin-top: 12px; }
  .custom-card .plan-desc { color: oklch(0.72 0.015 256); }
  .custom-card .plan-btn { display: inline-block; padding: 14px 28px; }
  .custom-features { border-left: 1px solid oklch(1 0 0 / 0.15); padding-left: 40px; gap: 14px; }
  .custom-features li { color: oklch(0.85 0.012 256); }
  .custom-features .dot { color: oklch(0.72 0.09 32); }

  .note { text-align: center; font-size: 13.5px; color: oklch(0.5 0.018 256); margin-top: 28px; }

  @media (max-width: 1100px) {
    .plans-grid.cols-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 820px) {
    section { padding: 64px 20px; }
    h2 { font-size: 30px; }
    .intro p { font-size: 15px; }
    .intro { margin-bottom: 28px; }
    .tab-list { width: 100%; margin-bottom: 24px; }
    .tab-list label { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: 10px 8px; font-size: 14px; white-space: normal; }
    .plans-grid.cols-3,
    .plans-grid.cols-4 { grid-template-columns: 1fr; gap: 14px; }
    .plan-card, .cols-4 .plan-card { padding: 24px 20px; }
    .plan-price, .cols-4 .plan-price { font-size: 30px; }
    .custom-card { grid-template-columns: 1fr; gap: 24px; padding: 28px 20px; }
    .custom-price { font-size: 28px; }
    .custom-card .plan-btn { display: block; }
    .custom-features { border-left: none; padding-left: 0; border-top: 1px solid oklch(1 0 0 / 0.15); padding-top: 24px; }
  }

  /* Na urządzeniach dotykowych bez zamiany kolorów przy "hoverze" */
  @media (hover: none) {
    .plan-card:not(.highlighted):hover { background: #fff; border-color: oklch(0.91 0.006 256); box-shadow: none; }
    .plan-card:not(.highlighted):hover .plan-name { color: oklch(0.45 0.02 256); }
    .plan-card:not(.highlighted):hover .plan-segment { color: oklch(0.55 0.1 32); }
    .plan-card:not(.highlighted):hover .plan-price { color: oklch(0.22 0.02 256); }
    .plan-card:not(.highlighted):hover :is(.plan-prefix, .plan-period, .plan-desc) { color: oklch(0.5 0.018 256); }
    .plan-card:not(.highlighted):hover .plan-limit { color: oklch(0.3 0.02 256); background: oklch(0.96 0.006 256); }
    .plan-card:not(.highlighted):hover li { color: oklch(0.35 0.02 256); }
    .plan-card:not(.highlighted):hover .dot { color: oklch(0.55 0.1 32); }
    .plan-card:not(.highlighted):hover hr { border-color: oklch(0.93 0.006 256); }
    .plan-card:not(.highlighted):hover .plan-btn-default { background: transparent; border-color: oklch(0.85 0.008 256); color: oklch(0.25 0.02 256); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted { background: oklch(0.22 0.02 256); border-color: oklch(0.22 0.02 256); box-shadow: 0 16px 40px rgba(20,28,45,.2); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-name { color: oklch(0.78 0.015 256); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-segment { color: oklch(0.72 0.09 32); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-price { color: #fff; }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted :is(.plan-prefix, .plan-period, .plan-desc) { color: oklch(0.72 0.015 256); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-limit { color: #fff; background: oklch(1 0 0 / 0.08); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted li { color: oklch(0.85 0.012 256); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .dot { color: oklch(0.72 0.09 32); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted hr { border-color: oklch(1 0 0 / 0.15); }
    .plans-grid:has(.plan-card:not(.highlighted):hover) .highlighted .plan-btn-hot { background: oklch(0.46 0.1 32); border: none; color: #fff; }
  }
</style>