---
// Sekcja „Blog” na stronie głównej — sama pokazuje 3 najnowsze artykuły z src/content/blog
import { getCollection } from "astro:content";
import PostCard from "./blog/PostCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

{posts.length > 0 && (
<section id="blog">
  <div class="container">
    <div class="header">
      <div class="text">
        <div class="eyebrow">Blog</div>
        <h2>Wiedza, która pomaga prowadzić firmę.</h2>
      </div>
      <a href="/blog/" class="all-link">Wszystkie artykuły →</a>
    </div>
    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</section>
)}

<style>
  section {
    padding: 96px 64px;
    background: #fff;
    border-top: 1px solid oklch(0.93 0.006 256);
  }

  .container { max-width: 1180px; margin: 0 auto; }

  .header {
    display: flex; align-items: flex-end;
    justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
  }

  .text { max-width: 620px; }

  .eyebrow {
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: oklch(0.5 0.1 32);
  }

  h2 {
    font-size: 44px; font-weight: 600;
    color: oklch(0.22 0.02 256); line-height: 1.08;
    margin-top: 14px; text-wrap: balance;
  }

  .all-link {
    display: inline-flex; align-items: center;
    padding: 12px 22px; border-radius: 8px;
    border: 1px solid oklch(0.86 0.008 256);
    color: oklch(0.27 0.022 256);
    font-weight: 600; font-size: 15px;
    white-space: nowrap;
    transition: border-color 0.2s;
  }

  .all-link:hover { border-color: oklch(0.6 0.02 256); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px; margin-top: 48px;
  }

  @media (max-width: 960px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 820px) {
    section { padding: 64px 20px; }

    h2 { font-size: 30px; }

    .grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 32px; gap: 16px;
    }
  }
</style>