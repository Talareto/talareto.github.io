---
// Footer.astro
---

<footer>
  <div class="container">
    <div class="brand-col">
      <div class="logo">
        <div class="logo-icon">
          <div class="logo-triangle"></div>
        </div>
        <span class="logo-name">CanLead</span>
      </div>
      <p>
        Biuro rachunkowe dla firm, które cenią spokój i terminowość.
        Księgowość, kadry i doradztwo w jednym miejscu.
      </p>
    </div>

    <div class="link-col">
      <div class="col-title">Usługi</div>
      <a href="#uslugi">Księgowość</a>
      <a href="#uslugi">Kadry i płace</a>
      <a href="#uslugi">Doradztwo podatkowe</a>
      <a href="#uslugi">Zakładanie firmy</a>
    </div>

    <div class="link-col">
      <div class="col-title">Firma</div>
      <a href="#o-nas">O nas</a>
      <a href="#cennik">Cennik</a>
      <a href="#blog">Blog</a>
      <a href="#kontakt">Kontakt</a>
    </div>

    <div class="link-col">
      <div class="col-title">Kontakt</div>
      <span>+48 600 000 000</span>
      <span>kontakt@canlead.pl</span>
      <span>ul. Przykładowa 12<br />00-000 Warszawa</span>
    </div>
  </div>

  <div class="bottom">
    <span>© 2026 CanLead · NIP 000-000-00-00</span>
    <div class="legal-links">
      <a href="#">Polityka prywatności</a>
      <a href="#">Regulamin</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: oklch(0.22 0.02 256);
    padding: 64px 64px 32px;
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: oklch(0.46 0.1 32);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-triangle {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 7px 0 7px 11px;
    border-color: transparent transparent transparent #fff;
    margin-left: 2px;
  }

  .logo-name {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: #fff;
  }

  .brand-col p {
    font-size: 14.5px;
    line-height: 1.6;
    color: oklch(0.7 0.015 256);
    margin-top: 18px;
    max-width: 300px;
  }

  /* Link columns */
  .link-col {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .col-title {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 5px;
  }

  .link-col a,
  .link-col span {
    font-size: 14.5px;
    color: oklch(0.7 0.015 256);
    line-height: 1.5;
  }

  .link-col a {
    transition: color 0.2s;
  }

  .link-col a:hover {
    color: #fff;
  }

  /* Bottom bar */
  .bottom {
    max-width: 1180px;
    margin: 48px auto 0;
    padding-top: 24px;
    border-top: 1px solid oklch(0.3 0.02 256);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
    color: oklch(0.6 0.015 256);
    flex-wrap: wrap;
    gap: 12px;
  }

  .legal-links {
    display: flex;
    gap: 24px;
  }

  .legal-links a {
    color: inherit;
    transition: color 0.2s;
  }

  .legal-links a:hover {
    color: #fff;
  }
</style>
