---
// Szablon pojedynczego artykułu: /blog/nazwa-pliku
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ArticleCover from "../../components/blog/ArticleCover.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const fmt = new Intl.DateTimeFormat("pl-PL", { day: "numeric", month: "long", year: "numeric" });
const words = (post.body ?? "").trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.ceil(words / 200));
const toc = headings.filter((h) => h.depth === 2);
const initials = data.author.name.split(" ").map((p) => p[0]).join("").slice(0, 2).toUpperCase();

// Powiązane: najpierw ta sama kategoria, potem najnowsze
const related = posts
  .filter((p) => p.id !== post.id)
  .sort((a, b) =>
    (Number(b.data.category === data.category) - Number(a.data.category === data.category)) ||
    (b.data.date.getTime() - a.data.date.getTime()))
  .slice(0, 3);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const shareUrl = encodeURIComponent(pageUrl);
---

<BaseLayout title={`${data.title} — CanLead`} description={data.description}>
  <header class="article-header">
    <Navbar />
    <div class="header-inner">
      <nav class="breadcrumbs" aria-label="Okruszki">
        <a href="/">Strona główna</a>
        <span aria-hidden="true">/</span>
        <a href="/#blog">Blog</a>
        <span aria-hidden="true">/</span>
        <span>{data.category}</span>
      </nav>

      <span class="category">{data.category}</span>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>

      <div class="meta">
        <div class="author">
          <span class="avatar" aria-hidden="true">{initials}</span>
          <span>
            <span class="author-name">{data.author.name}</span>
            <span class="author-role">{data.author.role}</span>
          </span>
        </div>
        <span class="meta-sep" aria-hidden="true"></span>
        <span class="meta-item"><time datetime={data.date.toISOString()}>{fmt.format(data.date)}</time></span>
        <span class="meta-dot" aria-hidden="true">·</span>
        <span class="meta-item">{readingMinutes} min czytania</span>
        {data.updated && (
          <>
            <span class="meta-dot" aria-hidden="true">·</span>
            <span class="meta-item">Zaktualizowano {fmt.format(data.updated)}</span>
          </>
        )}
      </div>
    </div>
  </header>

  <div class="cover-wrap">
    <ArticleCover category={data.category} cover={data.cover} alt={data.coverAlt} size="large" eager />
  </div>

  <main class="article-layout">
    <article class="article">
      {toc.length > 2 && (
        <details class="toc-mobile">
          <summary>Spis treści</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}

      {data.summary && (
        <aside class="summary" aria-label="W skrócie">
          <div class="summary-title">W skrócie</div>
          <ul>{data.summary.map((s) => <li>{s}</li>)}</ul>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>

      <p class="disclaimer">
        Artykuł ma charakter informacyjny i nie stanowi porady podatkowej w indywidualnej sprawie.
        Stan prawny na dzień {fmt.format(data.updated ?? data.date)}.
      </p>

      <div class="share">
        <span>Udostępnij:</span>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener">LinkedIn</a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
        <button type="button" class="copy-link" data-url={pageUrl}>Kopiuj link</button>
      </div>

      <section class="author-box" aria-label="O autorze">
        <span class="avatar avatar--lg" aria-hidden="true">{initials}</span>
        <div>
          <div class="author-box-label">O autorze</div>
          <div class="author-box-name">{data.author.name}</div>
          <div class="author-box-role">{data.author.role}</div>
          {data.author.bio && <p>{data.author.bio}</p>}
        </div>
      </section>
    </article>

    <aside class="sidebar">
      <div class="sticky">
        {toc.length > 0 && (
          <nav class="toc" aria-label="Spis treści">
            <div class="toc-title">Spis treści</div>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="side-cta">
          <div class="side-cta-title">Masz pytania?</div>
          <p>Umów bezpłatną konsultację — sprawdzimy, co ten temat oznacza dla Twojej firmy.</p>
          <a href="/#kontakt" class="btn-primary">Umów konsultację</a>
        </div>
      </div>
    </aside>
  </main>

  <section class="cta-band">
    <div class="cta-inner">
      <div>
        <h2>Zajmiemy się tym za Ciebie.</h2>
        <p>Prowadzimy księgi, kadry i podatki, a nowe przepisy wdrażamy, zanim staną się problemem.</p>
      </div>
      <a href="/#kontakt" class="btn-primary btn-lg">Umów bezpłatną konsultację</a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related">
      <div class="related-inner">
        <h2>Przeczytaj także</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a href={`/blog/${p.id}/`} class="card">
              <ArticleCover category={p.data.category} cover={p.data.cover} alt={p.data.coverAlt} size="card" />
              <div class="card-body">
                <span class="tag">{p.data.category}</span>
                <h3>{p.data.title}</h3>
                <div class="card-meta">
                  <span>{fmt.format(p.data.date)}</span>
                  <span class="read-more">Czytaj →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-link").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
        const old = btn.textContent;
        btn.textContent = "Skopiowano ✓";
        setTimeout(() => (btn.textContent = old), 1800);
      } catch {}
    });
  });
</script>

<style>
  /* ---------- Nagłówek ---------- */
  .article-header {
    background: oklch(0.22 0.02 256);
    position: relative;
  }

  .header-inner {
    max-width: 1028px;
    margin: 0 auto;
    padding: 44px 64px 160px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13.5px;
    color: oklch(0.6 0.015 256);
  }
  .breadcrumbs a { color: oklch(0.72 0.015 256); transition: color 0.2s; }
  .breadcrumbs a:hover { color: #fff; }

  .category {
    display: inline-block;
    margin-top: 28px;
    padding: 5px 12px;
    border-radius: 6px;
    background: oklch(0.46 0.1 32 / 0.18);
    border: 1px solid oklch(0.62 0.13 32 / 0.45);
    color: oklch(0.82 0.06 32);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin-top: 18px;
    font-size: 50px;
    line-height: 1.08;
    font-weight: 700;
    color: #fff;
    text-wrap: balance;
  }

  .lead {
    max-width: 720px;
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.6;
    color: oklch(0.76 0.015 256);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 32px;
    font-size: 14px;
    color: oklch(0.7 0.015 256);
  }

  .author { display: flex; align-items: center; gap: 12px; }
  .author-name { display: block; color: #fff; font-weight: 600; font-size: 14.5px; }
  .author-role { display: block; font-size: 13px; color: oklch(0.65 0.015 256); }

  .avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: oklch(0.46 0.1 32);
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 15px;
  }
  .avatar--lg { width: 64px; height: 64px; font-size: 22px; }

  .meta-sep { width: 1px; height: 28px; background: oklch(1 0 0 / 0.15); margin: 0 6px; }
  .meta-dot { color: oklch(0.5 0.015 256); }

  /* ---------- Okładka (nachodzi na nagłówek) ---------- */
  .cover-wrap {
    max-width: 1028px;
    margin: -112px auto 0;
    padding: 0 64px;
    position: relative;
    z-index: 2;
  }
  .cover-wrap :global(.cover) { box-shadow: 0 24px 60px rgba(15, 22, 36, 0.25); }

  /* ---------- Treść + panel boczny ---------- */
  .article-layout {
    max-width: 1028px;
    margin: 0 auto;
    padding: 64px 64px 80px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 248px;
    gap: 56px;
    align-items: start;
  }

  .sidebar { position: relative; height: 100%; }
  .sticky { position: sticky; top: 28px; display: flex; flex-direction: column; gap: 20px; }

  .toc {
    border-left: 2px solid oklch(0.91 0.006 256);
    padding-left: 18px;
  }
  .toc-title, .summary-title, .author-box-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: oklch(0.5 0.1 32);
  }
  .toc ol { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .toc a { font-size: 14px; line-height: 1.4; color: oklch(0.45 0.02 256); transition: color 0.2s; }
  .toc a:hover { color: oklch(0.22 0.02 256); }

  .side-cta {
    background: oklch(0.22 0.02 256);
    border-radius: 12px;
    padding: 22px;
  }
  .side-cta-title { font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: 18px; color: #fff; }
  .side-cta p { font-size: 14px; line-height: 1.55; color: oklch(0.74 0.015 256); margin-top: 8px; }
  .side-cta .btn-primary { margin-top: 16px; width: 100%; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 8px;
    background: oklch(0.46 0.1 32);
    color: #fff;
    font-weight: 600;
    font-size: 14.5px;
    transition: opacity 0.2s;
    white-space: nowrap;
  }
  .btn-primary:hover { opacity: 0.88; }
  .btn-lg { padding: 15px 28px; font-size: 16px; }

  /* ---------- Ramka „W skrócie” ---------- */
  .summary {
    background: #fff;
    border: 1px solid oklch(0.91 0.006 256);
    border-left: 4px solid oklch(0.46 0.1 32);
    border-radius: 0 10px 10px 0;
    padding: 22px 26px;
    margin-bottom: 40px;
  }
  .summary ul { margin: 12px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .summary li { font-size: 16px; line-height: 1.55; color: oklch(0.3 0.02 256); }
  .summary li::marker { color: oklch(0.46 0.1 32); }

  .toc-mobile { display: none; }

  /* ---------- Typografia artykułu ---------- */
  .prose {
    font-size: 17.5px;
    line-height: 1.8;
    color: oklch(0.32 0.02 256);
  }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(> p:first-child) { font-size: 19px; color: oklch(0.26 0.02 256); }

  .prose :global(h2) {
    font-size: 30px;
    line-height: 1.2;
    font-weight: 600;
    color: oklch(0.22 0.02 256);
    margin: 52px 0 18px;
    scroll-margin-top: 24px;
  }
  .prose :global(h3) {
    font-size: 21px;
    line-height: 1.3;
    font-weight: 600;
    color: oklch(0.22 0.02 256);
    margin: 36px 0 12px;
    scroll-margin-top: 24px;
  }

  .prose :global(strong) { color: oklch(0.22 0.02 256); font-weight: 700; }
  .prose :global(a) { color: oklch(0.46 0.1 32); text-decoration: underline; text-underline-offset: 3px; }

  .prose :global(ul), .prose :global(ol) { margin: 0 0 26px; padding-left: 0; list-style: none; }
  .prose :global(li) { position: relative; margin-bottom: 12px; padding-left: 30px; }

  .prose :global(ul > li)::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: oklch(0.46 0.1 32);
  }

  .prose :global(ol) { counter-reset: step; }
  .prose :global(ol > li) { counter-increment: step; padding-left: 44px; margin-bottom: 18px; }
  .prose :global(ol > li)::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.15em;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: oklch(0.22 0.02 256);
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: 14px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Cytat w Markdownie (> …) = ramka „Ważne” */
  .prose :global(blockquote) {
    margin: 32px 0;
    padding: 20px 24px;
    background: oklch(0.96 0.025 60);
    border: 1px solid oklch(0.88 0.06 60);
    border-radius: 10px;
    color: oklch(0.32 0.04 50);
    font-size: 16.5px;
    line-height: 1.65;
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(blockquote strong) { color: oklch(0.38 0.1 40); }

  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 8px 0 30px;
    font-size: 15.5px;
    line-height: 1.55;
    border: 1px solid oklch(0.9 0.006 256);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }
  .prose :global(th), .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 14px 16px;
    border-bottom: 1px solid oklch(0.92 0.006 256);
  }
  .prose :global(tr:last-child td) { border-bottom: none; }
  .prose :global(th) {
    background: oklch(0.22 0.02 256);
    color: #fff;
    font-weight: 600;
    font-size: 14px;
  }
  .prose :global(td:first-child) { font-weight: 600; color: oklch(0.24 0.02 256); white-space: nowrap; }

  .prose :global(img) { max-width: 100%; height: auto; border-radius: 10px; margin: 8px 0 24px; }
  .prose :global(hr) { border: none; border-top: 1px solid oklch(0.92 0.006 256); margin: 44px 0; }

  /* ---------- Pod artykułem ---------- */
  .disclaimer {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid oklch(0.92 0.006 256);
    font-size: 13.5px;
    line-height: 1.6;
    color: oklch(0.55 0.018 256);
  }

  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    font-size: 14px;
    color: oklch(0.45 0.02 256);
  }
  .share a, .share button {
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid oklch(0.88 0.008 256);
    background: #fff;
    color: oklch(0.27 0.02 256);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .share a:hover, .share button:hover { border-color: oklch(0.6 0.02 256); }

  .author-box {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-top: 36px;
    padding: 26px;
    background: #fff;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 12px;
  }
  .author-box-name { font-family: "Space Grotesk", sans-serif; font-size: 19px; font-weight: 700; color: oklch(0.22 0.02 256); margin-top: 6px; }
  .author-box-role { font-size: 14px; color: oklch(0.5 0.018 256); margin-top: 2px; }
  .author-box p { font-size: 15px; line-height: 1.6; color: oklch(0.38 0.02 256); margin-top: 10px; }

  /* ---------- Pas CTA ---------- */
  .cta-band { padding: 0 64px 88px; }
  .cta-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px 44px;
    border-radius: 16px;
    background-color: oklch(0.22 0.02 256);
    background-image: radial-gradient(circle at 100% 0%, oklch(0.46 0.1 32 / 0.35), transparent 50%);
  }
  .cta-inner h2 { font-size: 30px; font-weight: 700; color: #fff; line-height: 1.15; }
  .cta-inner p { font-size: 16px; line-height: 1.6; color: oklch(0.74 0.015 256); margin-top: 10px; max-width: 460px; }

  /* ---------- Powiązane ---------- */
  .related { background: #fff; border-top: 1px solid oklch(0.93 0.006 256); padding: 80px 64px 96px; }
  .related-inner { max-width: 900px; margin: 0 auto; }
  .related h2 { font-size: 32px; font-weight: 600; color: oklch(0.22 0.02 256); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid oklch(0.91 0.006 256);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover { box-shadow: 0 10px 28px rgba(20, 28, 45, 0.1); transform: translateY(-2px); }
  .card-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
  .tag {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 6px;
    background: oklch(0.96 0.005 256);
    font-size: 12px;
    font-weight: 600;
    color: oklch(0.45 0.02 256);
  }
  .card h3 { font-size: 17px; line-height: 1.3; font-weight: 600; color: oklch(0.24 0.02 256); margin-top: 12px; flex: 1; }
  .card-meta { display: flex; justify-content: space-between; margin-top: 16px; font-size: 13px; color: oklch(0.55 0.018 256); }
  .read-more { font-weight: 600; color: oklch(0.5 0.1 32); }

  /* ---------- Responsywność ---------- */
  @media (max-width: 960px) {
    .article-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .sidebar { display: none; }
    .toc-mobile {
      display: block;
      margin-bottom: 28px;
      border: 1px solid oklch(0.91 0.006 256);
      border-radius: 10px;
      background: #fff;
      padding: 14px 18px;
    }
    .toc-mobile summary { cursor: pointer; font-weight: 700; color: oklch(0.22 0.02 256); }
    .toc-mobile ol { margin: 12px 0 2px; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
    .toc-mobile a { color: oklch(0.4 0.02 256); font-size: 15px; }
    .related-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 820px) {
    .header-inner { padding: 28px 20px 110px; }
    h1 { font-size: 32px; }
    .lead { font-size: 17px; }
    .meta-sep { display: none; }
    .author { width: 100%; }
    .cover-wrap { margin-top: -80px; padding: 0 20px; }
    .cover-wrap :global(.cover--large) { aspect-ratio: 16 / 10; border-radius: 10px; }
    .article-layout { padding: 40px 20px 56px; }
    .prose { font-size: 16.5px; }
    .prose :global(> p:first-child) { font-size: 17.5px; }
    .prose :global(h2) { font-size: 24px; margin-top: 40px; }
    .prose :global(h3) { font-size: 19px; }
    .prose :global(table) { display: block; overflow-x: auto; font-size: 14px; }
    .prose :global(td:first-child) { white-space: normal; min-width: 110px; }
    .summary { padding: 18px 20px; }
    .author-box { flex-direction: column; padding: 22px; }
    .cta-band { padding: 0 20px 56px; }
    .cta-inner { flex-direction: column; align-items: flex-start; padding: 30px 24px; }
    .cta-inner h2 { font-size: 24px; }
    .cta-inner .btn-lg { width: 100%; }
    .related { padding: 56px 20px 64px; }
    .related h2 { font-size: 24px; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
