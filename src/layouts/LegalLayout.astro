---
// Wspólny szablon dla dokumentów prawnych (regulamin, polityka prywatności).
// Treść dokumentu piszesz w pliku .md w src/pages — trafia w miejsce <slot />.
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const { frontmatter } = Astro.props;
const { title, description, updated } = frontmatter;
---

<BaseLayout title={`${title} — CanLead`} description={description}>
  <header class="legal-header">
    <Navbar />
    <div class="legal-intro">
      <a href="/" class="back">← Wróć na stronę główną</a>
      <h1>{title}</h1>
      {updated && <p class="updated">Ostatnia aktualizacja: {updated}</p>}
    </div>
  </header>

  <main class="legal-main">
    <article class="legal-content">
      <slot />
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-header {
    background: oklch(0.22 0.02 256);
    position: relative;
  }

  .legal-intro {
    max-width: 1028px;
    margin: 0 auto;
    padding: 56px 64px 64px;
  }

  .back {
    display: inline-block;
    font-size: 14px;
    font-weight: 500;
    color: oklch(0.72 0.015 256);
    transition: color 0.2s;
  }
  .back:hover { color: #fff; }

  h1 {
    font-size: 48px;
    line-height: 1.08;
    font-weight: 700;
    color: #fff;
    margin-top: 18px;
  }

  .updated {
    font-size: 14px;
    color: oklch(0.65 0.015 256);
    margin-top: 14px;
  }

  .legal-main {
    padding: 64px 64px 96px;
  }

  .legal-content {
    max-width: 760px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.75;
    color: oklch(0.32 0.02 256);
  }

  /* Style dla treści z Markdowna */
  .legal-content :global(h2) {
    font-size: 24px;
    line-height: 1.25;
    font-weight: 600;
    color: oklch(0.22 0.02 256);
    margin: 48px 0 14px;
    padding-top: 28px;
    border-top: 1px solid oklch(0.92 0.006 256);
  }
  .legal-content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .legal-content :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: oklch(0.22 0.02 256);
    margin: 28px 0 8px;
  }

  .legal-content :global(p) { margin: 0 0 14px; }

  .legal-content :global(ol),
  .legal-content :global(ul) {
    margin: 0 0 16px;
    padding-left: 24px;
  }
  .legal-content :global(li) { margin-bottom: 8px; }
  .legal-content :global(li > ol),
  .legal-content :global(li > ul) { margin-top: 8px; }

  .legal-content :global(a) {
    color: oklch(0.46 0.1 32);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-content :global(strong) { color: oklch(0.22 0.02 256); }

  .legal-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 8px 0 18px;
    font-size: 15px;
    line-height: 1.55;
  }
  .legal-content :global(th),
  .legal-content :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 12px 14px;
    border: 1px solid oklch(0.91 0.006 256);
  }
  .legal-content :global(th) {
    background: oklch(0.96 0.006 256);
    color: oklch(0.22 0.02 256);
    font-weight: 600;
  }

  /* Miejsca do uzupełnienia — widoczne, żeby łatwo je znaleźć */
  .legal-content :global(mark) {
    background: oklch(0.93 0.07 85);
    color: oklch(0.3 0.06 60);
    padding: 1px 5px;
    border-radius: 4px;
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .legal-intro { padding: 36px 20px 44px; }
    h1 { font-size: 32px; }
    .legal-main { padding: 40px 20px 64px; }
    .legal-content { font-size: 15.5px; }
    .legal-content :global(h2) { font-size: 21px; margin-top: 36px; padding-top: 22px; }
    .legal-content :global(table) { font-size: 14px; }
    .legal-content :global(th),
    .legal-content :global(td) { padding: 10px; }
  }
</style>
